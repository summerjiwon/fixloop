# Copy this file to .env in the repository root before starting Docker Compose.
# Never commit .env. The mock/memory defaults work without any credentials.
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
DATA_BACKEND=memory
STORAGE_BACKEND=memory
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=issue-images

# Use localhost on one computer. For phone QR testing, replace both values with
# this computer's current Wi-Fi IP, for example http://192.168.0.10:8000.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_REPORT_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
